; Fichier de configuration du projet Godot.
; On le modifie surtout depuis l'éditeur (Projet > Paramètres du projet).

config_version=5

[application]

config/name="Jeu de Course"
config/description="Prototype « sensation de vitesse » du jeu de course d'Eric et Willy."
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.6", "Forward Plus")

[autoload]

Commandes="*res://scripts/commandes.gd"

[display]

window/size/viewport_width=1600
window/size/viewport_height=900

[rendering]

anti_aliasing/quality/msaa_3d=2
